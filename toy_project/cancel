#!/usr/bin/env python3
"""Toy cancel: mark a fake job cancelled so poll stops reporting it live."""

import argparse
import json
from pathlib import Path

JOBS = Path(__file__).parent / "jobs"


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("phase")
    ap.add_argument("--job-id", required=True)
    args = ap.parse_args()

    path = JOBS / f"{args.job_id}.json"
    if not path.exists():
        return 0  # already gone is the outcome we wanted
    job = json.loads(path.read_text())
    job["cancelled"] = True
    job["polls_left"] = 0
    job["pending_left"] = 0
    job["outcome"] = "failed"
    path.write_text(json.dumps(job, indent=2) + "\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
