#!/usr/bin/env python3
"""Toy collect: turns a finished fake job into result.json."""

import argparse
import json
from pathlib import Path

JOBS = Path(__file__).parent / "jobs"


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("phase")
    ap.add_argument("--job-id", required=True)
    ap.add_argument("--out", required=True)
    args = ap.parse_args()

    path = JOBS / f"{args.job_id}.json"
    if not path.exists():
        print(f"no such job: {args.job_id}")
        return 1
    job = json.loads(path.read_text())

    out = Path(args.out)
    out.mkdir(parents=True, exist_ok=True)

    delta = float(job["change"].get("delta", 0.0))
    score = round(0.50 + delta * job["scale"], 4)
    (out / "job_log.txt").write_text(
        f"job {job['job_id']} phase {job['phase']} finished: {job['outcome']}\n"
    )
    result = {
        "status": "passed" if job["outcome"] == "done" else "failed",
        "metrics": {"score": score},
        "notes": f"toy job {job['job_id']}",
        "artifacts": ["job_log.txt"],
    }
    (out / "result.json").write_text(json.dumps(result, indent=2) + "\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
