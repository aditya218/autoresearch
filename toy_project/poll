#!/usr/bin/env python3
"""Toy poll: counts down, then reports the job's configured outcome.

`outcome` may be an unknown status like "stuck" - the no-rule situation the
repair agent exists for.
"""

import argparse
import json
from pathlib import Path

JOBS = Path(__file__).parent / "jobs"


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("phase")
    ap.add_argument("--job-id", required=True)
    args = ap.parse_args()

    path = JOBS / f"{args.job_id}.json"
    if not path.exists():
        print(f"no such job: {args.job_id}")
        return 1

    job = json.loads(path.read_text())
    # `pending` polls happen before the job starts: queued, nothing running.
    if job.get("pending_left", 0) > 0:
        job["pending_left"] -= 1
        path.write_text(json.dumps(job, indent=2) + "\n")
        print("pending")
    elif job["polls_left"] > 0:
        job["polls_left"] -= 1
        path.write_text(json.dumps(job, indent=2) + "\n")
        print("running")
    else:
        print(job["outcome"])
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
