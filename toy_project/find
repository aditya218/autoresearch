#!/usr/bin/env python3
"""Toy find: look up jobs by the tag the engine attached at launch."""

import argparse
import json
from pathlib import Path

JOBS = Path(__file__).parent / "jobs"


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("phase")
    ap.add_argument("--tag", required=True)
    args = ap.parse_args()

    if not JOBS.exists():
        return 0
    for path in sorted(JOBS.glob("*.json")):
        job = json.loads(path.read_text())
        if job.get("tag") == args.tag and job.get("phase") == args.phase:
            print(job["job_id"])
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
