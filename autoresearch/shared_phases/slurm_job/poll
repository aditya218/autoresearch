#!/usr/bin/env python3
"""Shared phase: report a Slurm job's state.

Maps Slurm's vocabulary onto the engine's four statuses. `PENDING` is
reported as `pending` rather than `running` because a queued job has
consumed nothing and may never be placeable as submitted - a different
problem from a job that is simply slow.
"""

import argparse
import subprocess

PENDING = {"PENDING", "CONFIGURING"}
RUNNING = {"RUNNING", "REQUEUED", "RESIZING", "SUSPENDED", "COMPLETING"}
DONE = {"COMPLETED"}
FAILED = {
    "FAILED", "CANCELLED", "TIMEOUT", "OUT_OF_MEMORY", "NODE_FAIL",
    "BOOT_FAIL", "DEADLINE", "PREEMPTED",
}


def slurm_state(job_id: str) -> str:
    """sacct is authoritative and remembers finished jobs; squeue only knows
    live ones, so it is the fallback while accounting catches up."""
    proc = subprocess.run(
        ["sacct", "-j", job_id, "--format=State", "--noheader", "--parsable2"],
        capture_output=True, text=True,
    )
    if proc.returncode == 0 and proc.stdout.strip():
        return proc.stdout.strip().splitlines()[0].strip().split()[0]

    proc = subprocess.run(
        ["squeue", "-j", job_id, "-h", "-o", "%T"], capture_output=True, text=True
    )
    if proc.returncode == 0 and proc.stdout.strip():
        return proc.stdout.strip().splitlines()[0].strip()
    return "UNKNOWN"


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("phase")
    ap.add_argument("--job-id", required=True)
    args, _ = ap.parse_known_args()

    state = slurm_state(args.job_id)
    if state in PENDING:
        print("pending")
    elif state in RUNNING:
        print("running")
    elif state in DONE:
        print("done")
    elif state in FAILED:
        print("failed")
    else:
        print(state.lower())  # unknown to the engine: a repair situation
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
