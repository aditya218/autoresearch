#!/usr/bin/env python3
"""Shared phase: submit a job to Slurm.

Reusable across projects because the thing to run is a parameter, not baked
in. Configure it per phase:

    train:
      uses: slurm_job
      params:
        command: "python eval/train.py --workspace {workspace} --out {out}"
        partition: gpu
        gpus: 8
        time-limit: "04:00:00"

`{workspace}`, `{out}` and `{tag}` are substituted into the command.
"""

import argparse
import os
import subprocess
import sys
from pathlib import Path


def sbatch_directives(args) -> str:
    lines = [
        f"#SBATCH --job-name={args.tag}",
        f"#SBATCH --output={args.out}/slurm-%j.out",
        f"#SBATCH --error={args.out}/slurm-%j.err",
    ]
    if args.partition:
        lines.append(f"#SBATCH --partition={args.partition}")
    if args.time_limit:
        lines.append(f"#SBATCH --time={args.time_limit}")
    if args.cpus:
        lines.append(f"#SBATCH --cpus-per-task={args.cpus}")
    if args.mem:
        lines.append(f"#SBATCH --mem={args.mem}")
    if args.gpus:
        lines.append(f"#SBATCH --gres=gpu:{args.gpus}")
    if args.nodes:
        lines.append(f"#SBATCH --nodes={args.nodes}")
    for extra in args.sbatch or []:
        lines.append(f"#SBATCH {extra}")
    return "\n".join(lines)


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("phase")
    ap.add_argument("--tag", required=True)
    ap.add_argument("--workspace", required=True)
    ap.add_argument("--out", required=True)
    ap.add_argument("--command", required=True, help="what to run on the node")
    ap.add_argument("--partition", default=os.environ.get("SLURM_PARTITION"))
    ap.add_argument("--time-limit", dest="time_limit", default=None)
    ap.add_argument("--cpus", default=None)
    ap.add_argument("--mem", default=None)
    ap.add_argument("--gpus", default=None)
    ap.add_argument("--nodes", default=None)
    ap.add_argument("--sbatch", action="append", help="extra #SBATCH directive")
    args, _unknown = ap.parse_known_args()

    workspace = Path(args.workspace).resolve()
    out = Path(args.out).resolve()
    out.mkdir(parents=True, exist_ok=True)

    command = args.command.format(workspace=workspace, out=out, tag=args.tag)
    script = out / "job.sbatch"
    script.write_text(
        f"""#!/bin/bash
{sbatch_directives(args)}

set -euo pipefail
cd {workspace}
{command}
"""
    )
    script.chmod(0o755)

    proc = subprocess.run(
        ["sbatch", "--parsable", str(script)], capture_output=True, text=True
    )
    if proc.returncode != 0:
        print(proc.stderr.strip(), file=sys.stderr)
        return 1

    job_id = proc.stdout.strip().split(";")[0]
    if not job_id:
        print("sbatch printed no job id", file=sys.stderr)
        return 1
    print(job_id)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
