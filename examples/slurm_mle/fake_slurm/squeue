#!/usr/bin/env python3
"""A stand-in for `squeue`: the live queue only, as the real one behaves."""

import argparse
import json
import os
from pathlib import Path

STATE = Path(os.environ.get("FAKE_SLURM_STATE", ".fake_slurm")).resolve()


def alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except (ProcessLookupError, PermissionError):
        return False
    return True


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("-j", "--jobs", default=None)
    ap.add_argument("--name", default=None)
    ap.add_argument("-h", "--noheader", action="store_true")
    ap.add_argument("-o", "--format", default="%i")
    args, _ = ap.parse_known_args()

    if not STATE.exists():
        return 0
    for path in sorted(STATE.glob("*.json")):
        record = json.loads(path.read_text())
        if args.jobs and record["job_id"] != args.jobs:
            continue
        if args.name and record["name"] != args.name:
            continue
        if not alive(record["pid"]):
            continue  # finished jobs leave the queue
        print(record["job_id"] if "%i" in args.format else "RUNNING")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
