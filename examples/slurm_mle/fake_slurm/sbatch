#!/usr/bin/env python3
"""A stand-in for `sbatch`, for running this example without a cluster.

Submits by running the batch script in the background and recording enough
state for `sacct`/`squeue` to answer. The project's own scripts don't know
the difference - they issue real Slurm commands either way.

State lives in $FAKE_SLURM_STATE (default: ./.fake_slurm).
"""

import argparse
import json
import os
import random
import subprocess
import sys
from pathlib import Path

STATE = Path(os.environ.get("FAKE_SLURM_STATE", ".fake_slurm")).resolve()


def job_name_from(script: Path) -> str:
    for line in script.read_text().splitlines():
        if line.startswith("#SBATCH --job-name="):
            return line.split("=", 1)[1].strip()
    return "unnamed"


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--parsable", action="store_true")
    ap.add_argument("script")
    args, _ = ap.parse_known_args()

    STATE.mkdir(parents=True, exist_ok=True)
    script = Path(args.script).resolve()
    job_id = str(random.randint(100000, 999999))
    record = STATE / f"{job_id}.json"

    log = STATE / f"{job_id}.log"
    with open(log, "wb") as fh:
        proc = subprocess.Popen(
            ["bash", str(script)], stdout=fh, stderr=subprocess.STDOUT,
            start_new_session=True,
        )

    record.write_text(
        json.dumps(
            {"job_id": job_id, "pid": proc.pid, "name": job_name_from(script),
             "script": str(script), "log": str(log)}
        )
    )
    print(job_id)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
