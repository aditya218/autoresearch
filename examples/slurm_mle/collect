#!/usr/bin/env python3
"""Turn a finished Slurm job into the engine's `result.json`.

This is where a project decides what "passed" means. Here: the run produced
metrics and did not diverge. A diverged run is a real result about the idea,
so it is reported as `failed` - not as an infrastructure error.
"""

import argparse
import json
from pathlib import Path


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("phase")
    ap.add_argument("--job-id", required=True)
    ap.add_argument("--out", required=True)
    args = ap.parse_args()

    out = Path(args.out).resolve()
    metrics_path = out / "metrics.json"
    if not metrics_path.exists():
        # No metrics from a job Slurm called finished: the engine treats a
        # failed collect as a repair situation.
        print(f"no metrics.json in {out}")
        return 1

    metrics = json.loads(metrics_path.read_text())
    diverged = metrics.get("diverged") or metrics.get("val_rmse") is None

    result = {
        "status": "failed" if diverged else "passed",
        "metrics": (
            {}
            if diverged
            else {
                "val_rmse": metrics["val_rmse"],
                "train_rmse": metrics["train_rmse"],
                "train_seconds": metrics["seconds"],
            }
        ),
        "notes": (
            f"job {args.job_id} diverged"
            if diverged
            else f"job {args.job_id}: val_rmse={metrics['val_rmse']}"
        ),
        "artifacts": ["metrics.json"],
    }
    (out / "result.json").write_text(json.dumps(result, indent=2) + "\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
